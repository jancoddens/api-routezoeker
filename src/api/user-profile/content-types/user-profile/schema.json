{
  "kind": "collectionType",
  "collectionName": "user_profiles",
  "info": {
    "singularName": "user-profile",
    "pluralName": "user-profiles",
    "displayName": "User profile"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "default": "nl"
    },
    "postcode": {
      "type": "string"
    },
    "birth_date": {
      "type": "date"
    },
    "gender": {
      "type": "string"
    },
    "walking_club": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "legacy_user_controlnumber": {
      "type": "string",
      "unique": true
    },
    "legacy_rechten": {
      "type": "integer"
    },
    "legacy_status": {
      "type": "integer"
    },
    "legacy_created_at": {
      "type": "datetime"
    },
    "legacy_last_login_at": {
      "type": "datetime"
    }
  }
}
