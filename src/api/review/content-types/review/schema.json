{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Review",
    "description": "Reviews en foto's van wandelaars/fietsers over een route. Enkel reviews met review_status 'approved' zijn zichtbaar op de site."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "review_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "required": true
    },
    "route": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::route.route"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "author_name": {
      "type": "string",
      "maxLength": 80
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "required": true
    },
    "text": {
      "type": "text",
      "maxLength": 2000
    },
    "visited_on": {
      "type": "date"
    },
    "photos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "moderation_note": {
      "type": "text",
      "private": true
    }
  }
}
