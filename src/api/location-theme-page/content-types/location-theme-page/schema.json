  "collectionName": "location_theme_pages",
  "info": {
    "singularName": "location-theme-page",
    "pluralName": "location-theme-pages",
    "displayName": "Location theme page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
