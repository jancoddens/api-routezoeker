      "component": "general.seo",
      "repeatable": false
    },
    "theme": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::theme.theme",
      "inversedBy": "location_theme_pages"
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "inversedBy": "location_theme_pages"
    },
    "province": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::province.province",
      "inversedBy": "location_theme_pages"
    },
    "region": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::region.region",
      "inversedBy": "location_theme_pages"
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city",
      "inversedBy": "location_theme_pages"
    },
    "description": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "excerpt": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "content": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "page-blocks.text-section",
        "page-blocks.quote",
        "page-blocks.image-text",
        "page-blocks.image-gallery",
        "page-blocks.image-carousel",
        "page-blocks.hero-banner",
        "page-blocks.cards",
        "page-blocks.article-grid",
        "page-blocks.list",
        "page-blocks.region-slider"
