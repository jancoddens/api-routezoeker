{
  "kind": "collectionType",
  "collectionName": "node_networks",
  "info": {
    "singularName": "node-network",
    "pluralName": "node-networks",
    "displayName": "node_network"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "theme": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::theme.theme",
      "inversedBy": "node_networks"
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country",
      "inversedBy": "node_networks"
    },
    "province": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::province.province",
      "inversedBy": "node_networks"
    },
    "region": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::region.region",
      "inversedBy": "node_networks"
    },
    "image": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "source_config": {
      "type": "json"
    },
    "sync_enabled": {
      "type": "boolean",
      "default": false
    },
    "last_imported_at": {
      "type": "datetime"
    },
    "last_import_status": {
      "type": "enumeration",
      "default": "idle",
      "enum": [
        "idle",
        "success",
        "error"
      ]
    },
    "last_import_message": {
      "type": "text"
    },
    "node_network": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::node-network.node-network",
      "inversedBy": "node_networks"
    },
    "node_networks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::node-network.node-network",
      "mappedBy": "node_network"
    },
    "content": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "page-blocks.text-section",
        "page-blocks.region-slider",
        "page-blocks.quote",
        "page-blocks.list",
        "page-blocks.image-text",
        "page-blocks.image-gallery",
        "page-blocks.image-carousel",
        "page-blocks.hero-banner",
        "page-blocks.carousel-item",
        "page-blocks.cards",
        "page-blocks.article-grid"
      ]
    },
    "routes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::route.route",
      "mappedBy": "node_network"
    },
    "distance_km": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "latitude": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "longitude": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "is_virtual": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    }
  }
}
